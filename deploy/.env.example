# Copy to deploy/.env and adjust. Every line is optional except NIC.

# Network interface that reaches the extenders (ex. eth0, enp3s0). Required.
NIC=eth0
# Address the gateway adds on that interface, inside the extenders' fixed
# 192.168.167.0/24 network, as the source of keyboard/mouse packets. Pick one
# no extender uses (they take .10-.25 for TX IDs 1-16 and .90 for the receiver).
#HID_IP=192.168.167.3
# Where the page listens. Behind a reverse proxy on the same host: 127.0.0.1:8820
#LISTEN=0.0.0.0:8820
# Label for this machine in the page header (ex. the host name)
#HOST_NAME=gateway
# Stop every feed and leave the multicast groups after this many seconds with
# no visible page (0 = never). Saves ~0.8 CPU core per running feed.
#IDLE_SECS=120
# Intel GPU device and VAAPI driver: i965 up to 9th gen, iHD for newer; empty = auto
#RENDER_DEVICE=/dev/dri/renderD128
#LIBVA_DRIVER_NAME=

# ---- Login (README: "Reverse proxy and login") ------------------------------
# basic = built-in password (default; a fallback), proxy = trust your reverse
# proxy's authentication gateway, none = no login (only on an isolated network)
#KVM_AUTH=basic
#KVM_USER=kvm
# Unset = generated on first start, printed in the log, kept in the state volume
#KVM_PASS=
# Bearer tokens for scripts, comma-separated (Authorization: Bearer <token>)
#KVM_TOKENS=
# Reverse proxies allowed to send X-Forwarded-* and identity headers
#TRUSTED_PROXIES=127.0.0.1/32,::1/128
# proxy mode: header with the signed-in user (unset = Remote-User, X-Forwarded-User, ...)
#AUTH_USER_HEADER=Remote-User
#AUTH_ALLOWED_USERS=alice@example.com,bob@example.com
# proxy mode with a signed token instead of address trust (ex. Cloudflare Access)
#AUTH_JWKS_URL=https://example.cloudflareaccess.com/cdn-cgi/access/certs
#AUTH_JWT_HEADER=Cf-Access-Jwt-Assertion
#AUTH_JWT_AUDIENCE=
#AUTH_JWT_ISSUER=
# Path prefix if the proxy forwards /kvm/... without stripping it
#BASE_PATH=/kvm
# Extra page origins allowed to send keyboard/mouse (normally not needed)
#ALLOWED_ORIGINS=https://kvm.example.com

# ---- WebRTC media (README: "Network") ---------------------------------------
#WEBRTC_UDP_PORT=8189
# Also offer media over TCP (ex. :8189) for clients that cannot use UDP
#WEBRTC_TCP_ADDRESS=
# Extra addresses/host names to offer to browsers (ex. a public IP behind NAT)
#WEBRTC_ADDITIONAL_HOSTS=

# ---- Optional copy of each feed to another RTSP server ------------------------
#PUBLISH_BASE=rtsp://user:pass@203.0.113.5:8554/kvm
# JSON URL answering {"air": true|false}; copy only while on air (unset = always)
#STREAM_STATE_URL=
